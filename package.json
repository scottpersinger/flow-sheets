{
  "name": "flow-sheets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch --watch-path=server --watch-path=shared server/index.ts",
    "dev:client": "vite",
    "build": "vite build && vite build --config plugin/vite.config.ts",
    "start": "NODE_ENV=production node server/supervise.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "plugin:dev": "node --watch --watch-path=plugin/server --watch-path=server --watch-path=shared plugin/server/index.ts",
    "plugin:start": "NODE_ENV=production node plugin/server/index.ts",
    "plugin:build": "vite build --config plugin/vite.config.ts",
    "plugin:watch": "vite build --config plugin/vite.config.ts --watch",
    "plugin:harness": "vite --config plugin/vite.config.ts",
    "r2": "node server/scripts/r2.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.288",
    "@anthropic-ai/sdk": "^0.131.0",
    "@aws-sdk/client-s3": "^3.1147.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.5",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@openai/mcp-extensions": "^0.1.0",
    "@types/mdast": "^4.0.4",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.12.5",
    "github-markdown-css": "^5.9.0",
    "jszip": "^3.10.2",
    "pptxgenjs": "^4.0.1",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-dropcursor": "^1.8.4",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.12.2",
    "prosemirror-view": "^1.42.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "railway": "^3.12.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/scottpersinger/flow-sheets.git"
  },
  "engines": {
    "node": ">=24"
  }
}
