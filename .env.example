# Copy to .env (git-ignored) for local development. On Railway, set these as service variables instead.

# Required for the assistant. Create a key at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Optional
# AGENT_EFFORT=medium
# AGENT_DAILY_REQUEST_LIMIT=500

# Password reset email. With RESEND_API_KEY set, reset links are sent through Resend from MAIL_FROM; without it
# the message (including the link) is written to the server log instead. APP_URL is the public origin used in
# the link; it defaults to the origin of the request that asked for the reset.
# RESEND_API_KEY=
# MAIL_FROM=Sheets <noreply@your-domain.com>
# APP_URL=https://sheets.example.com

# Self-improvement publishing. When set, each app change the assistant makes is committed on a branch, pushed,
# opened as a pull request and merged. Needs a fine-grained token with Contents and Pull requests read/write.
# On Railway the repo is taken from RAILWAY_GIT_REPO_OWNER/NAME; elsewhere set GITHUB_REPO. Leave unset locally
# to keep changes uncommitted in the working tree.
# GITHUB_TOKEN=
# GITHUB_REPO=owner/name

# Local test account used when driving the app in a browser (dev only; register it with POST /api/auth/register)
# TEST_EMAIL=agent-test@example.com
# TEST_PASSWORD=agent-test-pass-2026
