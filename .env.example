# Copy to .env (git-ignored) for local development. On Railway, set these as service variables instead.

# Required for the assistant. Create a key at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Optional
# The live assistant's model: claude-sonnet-5-5 (default) or claude-opus-5-5. Restart the server after changing it.
# AGENT_MODEL=claude-sonnet-5-5
# The coding and research jobs (Claude Code) use ANTHROPIC_API_KEY and Claude Code's default model unless these
# are set: a separate key so the jobs are billed apart, and a model id to pin.
# CODING_API_KEY=
# CODING_MODEL=
# AGENT_EFFORT=medium
# AGENT_DAILY_REQUEST_LIMIT=500

# Web and image search for the assistant (web_search, image_search), via the Brave Search API. Without a key
# the assistant says search is unavailable. Keys: https://api-dashboard.search.brave.com (image search needs
# a plan that includes the Images endpoint).
# BRAVE_SEARCH_API_KEY=

# Password reset email. Sent through Cloudflare Email Service when CLOUDFLARE_ACCOUNT_ID and CLOUDFLARE_API_TOKEN
# are set (MAIL_FROM is then required and must be on a domain verified for sending in that account; the token
# needs the Email Sending permission), else through Resend when RESEND_API_KEY is set; without either the
# message (including the link) is written to the server log instead. APP_URL is the public origin used in the
# link; it defaults to the origin of the request that asked for the reset.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# RESEND_API_KEY=
# MAIL_FROM=Sheets <noreply@your-domain.com>
# APP_URL=https://sheets.example.com

# "Continue with Google" on the sign-in page. Create an OAuth client (Web application) in Google Cloud Console
# and add <APP_URL>/api/auth/google/callback (and http://localhost:5173/api/auth/google/callback for the dev
# server) as an authorised redirect URI. Unset, the button is not shown.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Old host names that should redirect (301) to APP_URL, keeping the path; comma-separated.
# LEGACY_HOSTS=old.example.com

# Self-improvement publishing. When set, each app change the assistant makes is committed on a branch, pushed,
# opened as a pull request and merged. Needs a fine-grained token with Contents and Pull requests read/write.
# On Railway the repo is taken from RAILWAY_GIT_REPO_OWNER/NAME; elsewhere set GITHUB_REPO. Leave unset locally
# to keep changes uncommitted in the working tree.
# GITHUB_TOKEN=
# GITHUB_REPO=owner/name

# Local test account used when driving the app in a browser (dev only; register it with POST /api/auth/register)
# TEST_EMAIL=agent-test@example.com
# TEST_PASSWORD=agent-test-pass-2026
